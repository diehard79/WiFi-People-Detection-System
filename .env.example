# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/wifi_detection
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=wifi_detection
INFLUXDB_BUCKET=detections

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# WiFi Configuration
WIFI_SAMPLING_RATE=1
WIFI_WINDOW_SIZE=20
WIFI_DETECTORS=4

# Calibration
CALIBRATION_DAILY_HOUR=3
CALIBRATION_DURATION_MINUTES=5

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Model paths
MODEL_PATH=/home/vinns/experiments/detectPeople/models
TRAINING_DATA_PATH=/home/vinns/experiments/detectPeople/data
